# 前端环境变量示例。复制为 .env.local 后修改。
# API 基础路径(生产由 nginx 反代到 /api/v1，开发由 vite proxy 代理)。
VITE_API_BASE=/api/v1
# 开发代理目标(vite.config.ts 使用)。
VITE_API_TARGET=http://localhost:8000
# 底图瓦片模板(内网部署可换为天地图/自建 TiTiler); z/x/y 占位符保留花括号。
# VITE_BASEMAP_TILES=https://your-tileserver/tiles/{z}/{x}/{y}.png
# VITE_BASEMAP_ATTR=© 自建底图
