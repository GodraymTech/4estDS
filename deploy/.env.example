# 4estDS 部署环境变量示例。复制为 deploy/.env 后根据实际修改。

# 对外访问端口(nginx)
HTTP_PORT=8080

# PostGIS
POSTGRES_USER=forestds
POSTGRES_PASSWORD=forestds
POSTGRES_DB=forestds

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- forestds 应用配置(供 api/worker 容器) ---
# 数据库: 默认为空=本地 SQLite(共享卷)。切 PostGIS 需先完成仓储层适配后启用下行。
# forestds_DB__URL=postgresql://forestds:forestds@postgis:5432/forestds

# 存储后端: local(共享卷, 默认) 或 s3(MinIO)
forestds_STORAGE_BACKEND=local
forestds_STORAGE_ROOT=/data/storage
# s3 时启用下列:
# forestds_STORAGE_BACKEND=s3
# forestds_S3_ENDPOINT=minio:9000
# forestds_S3_ACCESS_KEY=minioadmin
# forestds_S3_SECRET_KEY=minioadmin
# forestds_S3_BUCKET=forestds
# forestds_S3_SECURE=false

# 前端允许的跨域源(nginx 同域时可留空)
forestds_CORS_ORIGINS=http://localhost:8080

# Redis(由 compose 注入, 无需修改)
# REDIS_URL=redis://redis:6379/0
