# 4estDS Worker 镜像 (Dramatiq 消费 GPU 队列)。
# 包含完整推理依赖(detect/geo/multisource)。GPU 环境请改用 nvidia/cuda 基础镜像。
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libexpat1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src

# 安装包及其推理/地理/多源 extras + 运行时(队列/DB/存储)依赖(由 pyproject extras 声明)。
# GPU 推理机请改用 Dockerfile.worker.gpu(nvidia/cuda 基础镜像)。
RUN pip install ".[runtime,detect,geo,multisource]"

# GPU 队列 concurrency=1: 单进程单线程消费 gpu 队列，避免显存竞争。
# 模型在进程内常驻(actors._detector_cache)，首作业预热后复用。
CMD ["dramatiq", "forestds.worker.actors", "--queues", "gpu", "--processes", "1", "--threads", "1"]
